{
  "name": "qritique",
  "description": "Mark, annotate, and share visual feedback on any website.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Felix Folkebrant <felix.folkebrant@folkebrant.se>",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:preview": "vite --config vite.preview.config.ts",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "pnpm build && pnpm build:firefox",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "postinstall": "wxt prepare && lefthook install"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
